{
  "displayName": "Vertex AI Agent Engine ADK Agent Efficiency",
  "dashboardFilters": [
    {
      "filterType": "RESOURCE_LABEL",
      "labelKey": "job",
      "templateVariable": "agent",
      "valueType": "STRING"
    }
  ],
  "labels": {},
  "mosaicLayout": {
    "columns": 48,
    "tiles": [
      {
        "height": 10,
        "widget": {
          "text": {
            "content": "**Requires ADK experimental telemetry.** Most charts read `adk.experimental.*` metrics, which ADK emits only when the agent runs with `ADK_EXPERIMENTAL_TELEMETRY=true` and Agent Engine telemetry is on (`GOOGLE_CLOUD_AGENT_ENGINE_ENABLE_TELEMETRY=true`, or `adk deploy agent_engine --otel_to_cloud`). Without both, the dashboard stays empty. Experimental metric names can change between ADK releases.\n\nPick the agent with the **agent** filter (its Agent Engine ID). Charts show means per time step; the pie shows totals for the selected range.\n\n- **Turn**: one user message, through to the final response.\n- **Agent invocation**: one run of an agent during a turn. Per-turn counts exclude the root agent.\n- **Cached input** is part of input, and **reasoning** is part of output.",
            "format": "MARKDOWN",
            "style": {}
          }
        },
        "width": 48
      },
      {
        "height": 8,
        "widget": {
          "scorecard": {
            "gaugeView": {
              "upperBound": 1.0
            },
            "timeSeriesQuery": {
              "prometheusQuery": "sum(rate({\"__name__\"=\"adk.experimental.invoke_workflow.cache_read.input_tokens_sum\",\"job\"=~\"${agent.value}\",\"gen_ai.workflow.nested\"=\"\"}[${__interval}])) / sum(rate({\"__name__\"=\"adk.experimental.invoke_workflow.input_tokens_sum\",\"job\"=~\"${agent.value}\",\"gen_ai.workflow.nested\"=\"\"}[${__interval}]))"
            }
          },
          "title": "Cache-read ratio"
        },
        "width": 16,
        "yPos": 10
      },
      {
        "height": 8,
        "widget": {
          "scorecard": {
            "sparkChartView": {
              "sparkChartType": "SPARK_LINE"
            },
            "timeSeriesQuery": {
              "prometheusQuery": "sum(rate({\"__name__\"=\"adk.experimental.invoke_workflow.reasoning.output_tokens_sum\",\"job\"=~\"${agent.value}\",\"gen_ai.workflow.nested\"=\"\"}[${__interval}])) / sum(rate({\"__name__\"=\"adk.experimental.invoke_workflow.output_tokens_sum\",\"job\"=~\"${agent.value}\",\"gen_ai.workflow.nested\"=\"\"}[${__interval}]))"
            }
          },
          "title": "Reasoning share"
        },
        "width": 16,
        "xPos": 16,
        "yPos": 10
      },
      {
        "height": 16,
        "widget": {
          "pieChart": {
            "chartType": "DONUT",
            "dataSets": [
              {
                "timeSeriesQuery": {
                  "outputFullDuration": true,
                  "prometheusQuery": "label_replace(round(sum(increase({\"__name__\"=\"adk.experimental.invoke_workflow.input_tokens_sum\",\"job\"=~\"${agent.value}\",\"gen_ai.workflow.nested\"=\"\"}[${__interval}])) - sum(increase({\"__name__\"=\"adk.experimental.invoke_workflow.cache_read.input_tokens_sum\",\"job\"=~\"${agent.value}\",\"gen_ai.workflow.nested\"=\"\"}[${__interval}]))), \"token_type\", \"uncached input\", \"\", \"\") or label_replace(round(sum(increase({\"__name__\"=\"adk.experimental.invoke_workflow.cache_read.input_tokens_sum\",\"job\"=~\"${agent.value}\",\"gen_ai.workflow.nested\"=\"\"}[${__interval}]))), \"token_type\", \"cached input\", \"\", \"\") or label_replace(round(sum(increase({\"__name__\"=\"adk.experimental.invoke_workflow.output_tokens_sum\",\"job\"=~\"${agent.value}\",\"gen_ai.workflow.nested\"=\"\"}[${__interval}])) - sum(increase({\"__name__\"=\"adk.experimental.invoke_workflow.reasoning.output_tokens_sum\",\"job\"=~\"${agent.value}\",\"gen_ai.workflow.nested\"=\"\"}[${__interval}]))), \"token_type\", \"output (excluding reasoning)\", \"\", \"\") or label_replace(round(sum(increase({\"__name__\"=\"adk.experimental.invoke_workflow.reasoning.output_tokens_sum\",\"job\"=~\"${agent.value}\",\"gen_ai.workflow.nested\"=\"\"}[${__interval}]))), \"token_type\", \"reasoning\", \"\", \"\")"
                }
              }
            ],
            "showLabels": true
          },
          "title": "Total tokens by token type"
        },
        "width": 16,
        "xPos": 32,
        "yPos": 10
      },
      {
        "height": 8,
        "widget": {
          "scorecard": {
            "sparkChartView": {
              "sparkChartType": "SPARK_LINE"
            },
            "timeSeriesQuery": {
              "prometheusQuery": "sum(rate({\"__name__\"=\"adk.experimental.invoke_workflow.total_tokens_sum\",\"job\"=~\"${agent.value}\",\"gen_ai.workflow.nested\"=\"\"}[${__interval}])) / sum(rate({\"__name__\"=\"adk.experimental.invoke_workflow.total_tokens_count\",\"job\"=~\"${agent.value}\",\"gen_ai.workflow.nested\"=\"\"}[${__interval}]))"
            }
          },
          "title": "Mean tokens per turn"
        },
        "width": 16,
        "yPos": 18
      },
      {
        "height": 8,
        "widget": {
          "scorecard": {
            "sparkChartView": {
              "sparkChartType": "SPARK_LINE"
            },
            "timeSeriesQuery": {
              "prometheusQuery": "sum(rate({\"__name__\"=\"adk.experimental.invoke_agent.total_tokens_count\",\"job\"=~\"${agent.value}\"}[${__interval}]) unless on(\"gen_ai.agent.name\") label_replace({\"__name__\"=\"adk.experimental.invoke_workflow.total_tokens_count\",\"job\"=~\"${agent.value}\",\"gen_ai.workflow.nested\"=\"\"}, \"gen_ai.agent.name\", \"$1\", \"adk.experimental.root_agent.name\", \"(.*)\")) / sum(rate({\"__name__\"=\"adk.experimental.invoke_workflow.total_tokens_count\",\"job\"=~\"${agent.value}\",\"gen_ai.workflow.nested\"=\"\"}[${__interval}]))"
            }
          },
          "title": "Mean agent invocations per turn"
        },
        "width": 16,
        "xPos": 16,
        "yPos": 18
      },
      {
        "height": 64,
        "widget": {
          "collapsibleGroup": {},
          "title": "Per turn"
        },
        "width": 48,
        "yPos": 42
      },
      {
        "height": 16,
        "widget": {
          "title": "Mean tokens per turn — by token type",
          "xyChart": {
            "chartOptions": {
              "mode": "COLOR"
            },
            "dataSets": [
              {
                "minAlignmentPeriod": "300s",
                "plotType": "LINE",
                "targetAxis": "Y1",
                "timeSeriesQuery": {
                  "prometheusQuery": "sum by (\"series\") (label_replace(sum(rate({\"__name__\"=\"adk.experimental.invoke_workflow.input_tokens_sum\",\"job\"=~\"${agent.value}\",\"gen_ai.workflow.nested\"=\"\"}[${__interval}])) / sum(rate({\"__name__\"=\"adk.experimental.invoke_workflow.input_tokens_count\",\"job\"=~\"${agent.value}\",\"gen_ai.workflow.nested\"=\"\"}[${__interval}])), \"series\", \"input\", \"\", \"\") or label_replace(sum(rate({\"__name__\"=\"adk.experimental.invoke_workflow.output_tokens_sum\",\"job\"=~\"${agent.value}\",\"gen_ai.workflow.nested\"=\"\"}[${__interval}])) / sum(rate({\"__name__\"=\"adk.experimental.invoke_workflow.output_tokens_count\",\"job\"=~\"${agent.value}\",\"gen_ai.workflow.nested\"=\"\"}[${__interval}])), \"series\", \"output\", \"\", \"\") or label_replace(sum(rate({\"__name__\"=\"adk.experimental.invoke_workflow.cache_read.input_tokens_sum\",\"job\"=~\"${agent.value}\",\"gen_ai.workflow.nested\"=\"\"}[${__interval}])) / sum(rate({\"__name__\"=\"adk.experimental.invoke_workflow.cache_read.input_tokens_count\",\"job\"=~\"${agent.value}\",\"gen_ai.workflow.nested\"=\"\"}[${__interval}])), \"series\", \"cached input\", \"\", \"\") or label_replace(sum(rate({\"__name__\"=\"adk.experimental.invoke_workflow.reasoning.output_tokens_sum\",\"job\"=~\"${agent.value}\",\"gen_ai.workflow.nested\"=\"\"}[${__interval}])) / sum(rate({\"__name__\"=\"adk.experimental.invoke_workflow.reasoning.output_tokens_count\",\"job\"=~\"${agent.value}\",\"gen_ai.workflow.nested\"=\"\"}[${__interval}])), \"series\", \"reasoning\", \"\", \"\"))"
                }
              }
            ],
            "yAxis": {
              "label": "tokens",
              "scale": "LINEAR"
            }
          }
        },
        "width": 48,
        "yPos": 42
      },
      {
        "height": 16,
